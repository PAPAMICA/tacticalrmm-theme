diff --git a/src/css/app.sass b/src/css/app.sass
index 2280f2a..0c63807 100644
--- a/src/css/app.sass
+++ b/src/css/app.sass
@@ -1 +1,32 @@
 // app global css in Sass form
+
+@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap")
+
+@import "dracula.sass"
+@import "themes.sass"
+@import "dracula-components.sass"
+
+.xterm .xterm-viewport
+  scrollbar-width: thin
+  scrollbar-color: rgba(189, 147, 249, 0.35) transparent
+
+.xterm .xterm-viewport::-webkit-scrollbar-track
+  background: transparent
+
+.xterm .xterm-viewport::-webkit-scrollbar-thumb
+  background-color: rgba(189, 147, 249, 0.35)
+  border-radius: 8px
+  border: 2px solid transparent
+  background-clip: content-box
+
+.xterm .xterm-viewport::-webkit-scrollbar-thumb:hover
+  background-color: rgba(189, 147, 249, 0.6)
+
+.xterm .xterm-viewport::-webkit-scrollbar-thumb
+  opacity: 0
+  transition: opacity 0.2s ease
+
+.xterm .xterm-viewport::-webkit-scrollbar-button
+  display: none
+  width: 0
+  height: 0
