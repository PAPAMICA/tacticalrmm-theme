diff --git a/src/css/app.sass b/src/css/app.sass
index 2280f2a..dd4c56d 100644
--- a/src/css/app.sass
+++ b/src/css/app.sass
@@ -1 +1,26 @@
 // app global css in Sass form
+
+@import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap")
+
+@import "themes/index.sass"
+
+.xterm .xterm-viewport
+  scrollbar-width: thin
+  scrollbar-color: color-mix(in srgb, var(--theme-primary) 35%, transparent) transparent
+
+.xterm .xterm-viewport::-webkit-scrollbar-track
+  background: transparent
+
+.xterm .xterm-viewport::-webkit-scrollbar-thumb
+  background-color: color-mix(in srgb, var(--theme-primary) 35%, transparent)
+  border-radius: 8px
+  border: 2px solid transparent
+  background-clip: content-box
+
+.xterm .xterm-viewport::-webkit-scrollbar-thumb:hover
+  background-color: color-mix(in srgb, var(--theme-primary) 60%, transparent)
+
+.xterm .xterm-viewport::-webkit-scrollbar-button
+  display: none
+  width: 0
+  height: 0
